# ============================================
# 微信 AI 使用技巧整理站 — 环境变量模板
# ============================================
# 复制为 .env.local 后填写真实值。
# .env.local 必须加入 .gitignore（已默认）
# 严禁将任何含真实密钥的文件提交到 git

# ---------- CloudBase ----------
# 来自 CloudBase 控制台 → 环境设置
CLOUDBASE_ENV_ID=your-env-id-xxxxxxxx
CLOUDBASE_REGION=ap-shanghai

# CloudBase API 密钥（来自访问管理 → API 密钥管理）
# 服务端使用；前端 bundle 严禁出现
CLOUDBASE_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxx
CLOUDBASE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- PostgreSQL（直接连接 CloudBase PG）----------
# 在 CloudBase 控制台 → 数据库 → 连接信息 取得
PGHOST=your-postgres-host.tencentcloud.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=app_user
PGPASSWORD=your-strong-password
PGSSLMODE=require
PGPOOL_MAX=5

# ---------- CloudBase 存储 ----------
CLOUDBASE_STORAGE_BUCKET=wx-ai-tips

# ---------- 飞书（lark-cli 凭证）----------
# 飞书自建应用 → 凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 飞书知识库 / 多维表格的目标节点 ID（用 | 分隔多个）
FEISHU_SOURCE_IDS=wiki_xxxxx|base_xxxxx

# ---------- MCP ----------
# 客户端连接 MCP server 时使用的 Bearer Token
# 生成建议：openssl rand -base64 32
MCP_BEARER_TOKEN=replace-with-strong-random-token

# CloudBase 函数运行时校验 Origin（防止 DNS rebinding）
MCP_ALLOWED_ORIGINS=https://claude.ai,https://cursor.sh

# ---------- 后台 / 鉴权 ----------
# 管理员 IP 白名单（逗号分隔）
ADMIN_IP_WHITELIST=127.0.0.1,your.public.ip.address

# ---------- 备份 ----------
BACKUP_KEEP_WEEKS=8
BACKUP_S3_KEY_PREFIX=backups/

# ---------- 速率限制 ----------
RATE_LIMIT_PUBLIC_RPM=100
RATE_LIMIT_SEARCH_RPM=30
RATE_LIMIT_ADMIN_RPM=10
RATE_LIMIT_MCP_RPM=200

# ---------- Next.js ----------
NEXT_PUBLIC_SITE_URL=https://wx-ai-tips.example.com
NEXT_PUBLIC_SITE_NAME=微信 AI 技巧站

# ---------- 本地开发 ----------
# 设为 "local" 跳过 CloudBase 远程调用，使用 docker-compose 的本地服务
APP_ENV=local