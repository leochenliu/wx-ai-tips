{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wx-ai-tips.example.com/schemas/tag.json",
  "title": "Tag",
  "type": "object",
  "required": ["id", "slug", "name"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-\\u4e00-\\u9fa5]{2,80}$",
      "description": "URL 友好；中文或英文小写连字符"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "历史 slug 列表；旧链接可继续命中"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "articleCount": {
      "type": "integer",
      "minimum": 0,
      "description": "派生字段；不持久化"
    }
  }
}