{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wx-ai-tips.example.com/schemas/article.json",
  "title": "Article",
  "description": "微信 AI 使用技巧文章",
  "type": "object",
  "required": ["id", "slug", "title", "contentMarkdown", "status"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "内部唯一标识"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,80}$",
      "description": "URL 友好标识符"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "contentMarkdown": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "description": "飞书原文链接；写入后不可修改"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "archived"]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": { "$ref": "tag.json" }
    },
    "screenshots": {
      "type": "array",
      "items": { "$ref": "screenshot.json" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "published" } },
        "required": ["status"]
      },
      "then": {
        "required": ["title", "contentMarkdown", "publishedAt"]
      }
    }
  ]
}